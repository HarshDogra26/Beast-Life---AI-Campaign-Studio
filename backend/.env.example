PROVIDER_MODE=fixture

# --- Azure OpenAI: chat ----------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_CHAT_API_VERSION=2024-10-21

# --- Azure OpenAI: images --------------------------------------------------
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2.5-sunburst
AZURE_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
IMAGE_QUALITY=high
IMAGE_INPUT_FIDELITY=high
IMAGE_RPM=5

# --- Tavily (read by the MCP research server only) -------------------------
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- MCP research server ---------------------------------------------------
MCP_RESEARCH_URL=http://127.0.0.1:8765/mcp
MCP_RESEARCH_HOST=127.0.0.1
MCP_RESEARCH_PORT=8765

# --- Research agent bounds -------------------------------------------------
MAX_SEARCH_CALLS=4
MAX_FETCH_CALLS=6
RESEARCH_WALL_CLOCK_S=120
MIN_SOURCES=3

# --- Timeouts & retries ----------------------------------------------------
LLM_TIMEOUT_S=120
IMAGE_TIMEOUT_S=180
VIDEO_TIMEOUT_S=180
MAX_RETRIES=3
RETRY_BASE_DELAY_S=1.0

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./var/studio.sqlite
ARTIFACT_DIR=./var/artifacts
CHECKPOINT_DB=./var/checkpoints.sqlite

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp

# --- Video -----------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_TARGET_SECONDS=8.0

# --- Testing / review aids -------------------------------------------------
FAILURE_INJECT=
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173
